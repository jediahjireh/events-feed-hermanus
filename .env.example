# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Anthropic (Claude Haiku for extraction/review agents)
ANTHROPIC_API_KEY=sk-ant-...

# SerpAPI (Google Events, Eventbrite, TripAdvisor — confirmed reliable for Hermanus)
SERPAPI_API_KEY=...

# Apify (Facebook Events, Quicket actors)
APIFY_API_KEY=...

# Vercel Cron (protects GET /api/cron — Vercel auto-injects this for configured cron jobs)
CRON_SECRET=your-cron-secret-here
